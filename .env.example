# ─── Server ───────────────────────────────────────────────────────────────────
PORT=
NODE_ENV=development
CORS_ORIGIN=

# ─── Firebase Admin SDK (Service Account) ─────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Firebase Client SDK (used by browser / client-side JS) ───────────────────
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=

# ─── LLM / AI Assistant (Gemini API) ───────────────────────────────────────────
LLM_API_KEY=
LLM_PROVIDER=gemini
